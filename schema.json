    html.js-anim .u-display-xl:not(.no-animate),
    html.js-anim .u-animated-text { opacity: 0; }
  }

  /* Word animation */
  .animate-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .animate-space { display: inline; opacity: 0; }
  span.animate-word { text-decoration: inherit; }
  .word-animation-processed { opacity: 1 !important; }

  /* Word rotation */
  .rotating-text { position: relative; display: inline-block; vertical-align: baseline; }
  .rotating-text-item {
    display: inline-block; opacity: 1; transform: translateY(0);
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rotating-text-item.exit  { opacity: 0; transform: translateY(-16px); }
  .rotating-text-item.enter { opacity: 0; transform: translateY(16px); }

  /* Custom YouTube player base styles */
  .video_player_iframe_container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none; }
  .video_player_iframe_container.active { display: block; }
  .video_player_thumbnail { display: flex !important; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; }
  .video_player_play_btn { position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; z-index: 10 !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .animate-word, .rotating-text-item {
      transition: none !important;
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  }
</style>

